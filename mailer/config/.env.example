# insta-hammer — секреты (файл .env в state/, вне git)
# ANTYPANEL_URL=http://127.0.0.1:3200
# ANTYPANEL_TOKEN=<из data/settings.json панели — НЕ коммитить>
# IH_TIME_SCALE=1            # 0.1 — только для тестов (сжимает человеческие паузы)
# IH_LLM_API_KEY=            # OpenRouter
# IH_LLM_MODEL=              # дефолт: быстрый дешёвый (deepseek-класс)
# IH_LLM_MODEL_QA=            # для manual QA compose
# IH_CLASSIFY_ONLY=0          # 1 — только LLM-слой, без отправки
# TG_ALERT_BOT_TOKEN=         # Phase 4
